# Secret used to sign session cookies (required in production).
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app, e.g. https://scrape.example.com (required behind a proxy).
BETTER_AUTH_URL=
# SQLite file holding accounts, sessions and scrape history (default: data/scrape-zone.sqlite).
# DATABASE_PATH=
