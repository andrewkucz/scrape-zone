{
  "name": "scrape",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for scrape-zone (web scraping test bed) and the scrape-ts library.",
  "homepage": "https://github.com/andrewkucz/scrape-zone#readme",
  "bugs": {
    "url": "https://github.com/andrewkucz/scrape-zone/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewkucz/scrape-zone.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp run --filter scrape-zone dev",
    "build": "vp run -r build",
    "start": "vp run --filter scrape-zone start",
    "test": "vp run -r test",
    "release": "vp check && bumpp package.json apps/web/package.json --git-check",
    "release:scrape-ts": "vp check && vp run --filter scrape-ts test && vp run --filter scrape-ts release",
    "prepare": "vp config"
  },
  "devDependencies": {
    "bumpp": "^12.3.0",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  }
}
