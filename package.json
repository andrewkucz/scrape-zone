{
  "name": "scrape-zone",
  "version": "0.0.0",
  "private": true,
  "description": "Web scraping test bed: inspect JSON scripts, Next.js RSC props, network requests and HTML from any page.",
  "homepage": "https://github.com/andrewkucz/scrape-zone#readme",
  "bugs": {
    "url": "https://github.com/andrewkucz/scrape-zone/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewkucz/scrape-zone.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.ts",
    "preview": "vp build && pnpm start",
    "release": "vp check && bumpp --git-check",
    "prepare": "vp config"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "hono": "^4.13.13",
    "js-beautify": "^2.0.3",
    "playwright": "^1.63.0",
    "quicktype-core": "^26.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "scrape-ts": "1.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bumpp": "^12.3.0",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  }
}
