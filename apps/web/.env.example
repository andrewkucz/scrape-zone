# Secret used to sign session cookies (required in production).
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app, e.g. https://scrape.example.com (required behind a proxy).
BETTER_AUTH_URL=
# SQLite file holding accounts, sessions and scrape history (default: data/scrape-zone.sqlite).
# DATABASE_PATH=
# Comma-separated emails allowed to create accounts (case-insensitive).
# Empty or unset blocks all signups, including create-user. Restart after changing.
# Example: USER_EMAILS=alice@example.com,bob@example.com
USER_EMAILS=
